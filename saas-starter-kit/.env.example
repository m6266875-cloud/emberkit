# Copy this file to .env.local inside saas-starter-kit.
# Never commit .env.local or share real credentials.

# PostgreSQL (server only). For Neon, use the pooled connection here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Use the direct/unpooled connection for schema migrations.
# For a non-pooled PostgreSQL server, set this to the same URL as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Generate a random secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional Stripe subscription billing. Leave empty to disable checkout.
# Use test-mode keys while developing.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""
